diff --git a/src/allocator.rs b/src/allocator.rs
new file mode 100644
index 0000000..8fb0851
--- /dev/null
+++ b/src/allocator.rs
@@ -0,0 +1,64 @@
+//! The global allocator, and the one place that decides which one it is.
+//!
+//! Without `alloc-talc` this module is empty and the target's default stays
+//! installed (dlmalloc, through `std`). With it, talc is installed instead, or
+//! handed to `memory_profile`'s counting wrapper when that is also on: a crate
+//! declares exactly one `#[global_allocator]`, so the two cannot both be it.
+//!
+//! The `cfg` mirrors upstream's: a `TalcSyncCell` is only sound where nothing
+//! can interrupt an allocation, so a build with atomics keeps the default.
+//! `codegen/` and any other host tooling build for the host and never see this.
+
+#[cfg(all(
+    feature = "alloc-talc",
+    not(target_feature = "atomics"),
+    target_family = "wasm"
+))]
+pub(crate) mod talc_instance {
+    #[cfg(feature = "alloc-talc-arena")]
+    mod chosen {
+        /// 128 MiB, the size upstream's arena example uses. Committed on the
+        /// first allocation and never given back.
+        const ARENA_BYTES: usize = 0x800_0000;
+
+        pub(crate) type Allocator = talc::wasm::WasmArenaTalc;
+
+        pub(crate) const fn new() -> Allocator {
+            use core::mem::MaybeUninit;
+            static mut ARENA: [MaybeUninit<u8>; ARENA_BYTES] = [MaybeUninit::uninit(); ARENA_BYTES];
+            // SAFETY: `ARENA` is named nowhere else in the crate, so nothing
+            // but the allocator reads or writes it for the whole life of the
+            // module, which is what `Claim::array` requires of the region it is
+            // handed. `new_wasm_arena_allocator` is additionally sound only on
+            // single-threaded wasm, which this module's `cfg` establishes.
+            unsafe { talc::wasm::new_wasm_arena_allocator(&raw mut ARENA) }
+        }
+    }
+
+    #[cfg(all(not(feature = "alloc-talc-arena"), feature = "alloc-talc-claim"))]
+    mod chosen {
+        pub(crate) type Allocator =
+            talc::cell::TalcSyncCell<talc::wasm::WasmGrowAndClaim, talc::wasm::WasmBinning>;
+
+        pub(crate) const fn new() -> Allocator {
+            talc::cell::TalcSyncCell::new_wasm(talc::wasm::WasmGrowAndClaim)
+        }
+    }
+
+    #[cfg(all(not(feature = "alloc-talc-arena"), not(feature = "alloc-talc-claim")))]
+    mod chosen {
+        pub(crate) type Allocator = talc::wasm::WasmDynamicTalc;
+
+        pub(crate) const fn new() -> Allocator {
+            talc::wasm::new_wasm_dynamic_allocator()
+        }
+    }
+
+    pub(crate) use chosen::Allocator;
+
+    /// `memory_profile` takes the `#[global_allocator]` slot when it is built
+    /// and delegates here, so the attribute is conditional and the static is
+    /// not.
+    #[cfg_attr(not(feature = "memory-profiling"), global_allocator)]
+    pub(crate) static TALC: Allocator = chosen::new();
+}
